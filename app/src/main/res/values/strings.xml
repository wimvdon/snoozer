    <!-- Guide: notification access -->
    <string name="guide_access_title">Notification access</string>
    <string name="guide_access_why_title">Why is this needed?</string>
    <string name="guide_access_why_body">Android only lets apps with notification access snooze notifications from other apps. Without it, Snoozer can\'t do its job.</string>
    <string name="guide_access_step1">Tap \"Open settings\" below.</string>
    <string name="guide_access_step2">Find %1$s in the list and switch on \"Allow notification access\".</string>
    <string name="guide_access_step3">Confirm by tapping \"Allow\" in the dialog.</string>
    <string name="guide_access_step4">Come back here. The snooze button is now ready to use.</string>
    <string name="guide_access_open_settings">Open settings</string>
    <string name="guide_access_granted_title">You\'re all set</string>
    <string name="guide_access_granted_body">Notification access is on. You can now snooze all notifications with one tap.</string>
    <string name="guide_access_back_home">Back to Snoozer</string>
    <string name="guide_access_restricted_title">Switch greyed out?</string>
    <string name="guide_access_restricted_body">If you installed Snoozer from outside an app store, Android blocks this setting at first. Open App info, tap the ⋮ menu in the top corner, choose \"Allow restricted settings\", and try again.</string>
    <string name="guide_access_open_app_info">Open App info</string>
    <string name="guide_access_privacy_title">Your privacy</string>
    <string name="guide_access_privacy_body">Snoozer only uses this access to snooze and restore notifications. It never reads, stores or shares their content, and it has no internet access.</string>

    <!-- Guide: Quick Settings tile and launcher shortcut -->
    <string name="guide_tile_title">Quick Settings tile</string>
    <string name="guide_tile_intro">Add the Snooze tile to your Quick Settings to snooze or unsnooze from anywhere, without opening the app.</string>
    <string name="guide_tile_quick_add_title">Add it in one tap</string>
    <string name="guide_tile_quick_add_body">Your phone can add the tile for you. Tap the button and confirm.</string>
    <string name="guide_tile_quick_add_button">Add tile</string>
    <string name="guide_tile_result_added">Tile added. Swipe down to find it.</string>
    <string name="guide_tile_result_already">The tile is already in your Quick Settings.</string>
    <string name="guide_tile_result_not_added">The tile was not added.</string>
    <string name="guide_tile_result_error">Your phone couldn\'t add the tile automatically. Please follow the steps below.</string>
    <string name="guide_tile_manual_title">Add it yourself</string>
    <string name="guide_tile_step1">Swipe down twice from the top of the screen to open Quick Settings.</string>
    <string name="guide_tile_step2">Tap the edit (pencil) button.</string>
    <string name="guide_tile_step3">Find the \"%1$s\" tile and drag it to your active tiles.</string>
    <string name="guide_tile_step4">Tap the tile to switch snoozing on or off. Touch and hold it to open Snoozer.</string>
    <string name="guide_shortcut_title">Home screen shortcut</string>
    <string name="guide_shortcut_step1">Touch and hold the %1$s app icon.</string>
    <string name="guide_shortcut_step2">Tap \"%1$s\" to switch snoozing on or off instantly.</string>
    <string name="guide_shortcut_step3">Optional: drag the shortcut onto your home screen for one-tap access.</string>

    <!-- Guide: Tasker -->
    <string name="guide_tasker_title">Tasker automation</string>
    <string name="guide_tasker_intro">%1$s is a Tasker plug-in. Let Tasker snooze your notifications automatically, for example at bedtime, during meetings or while driving.</string>
    <string name="guide_tasker_open">Open Tasker</string>
    <string name="guide_tasker_get">Get Tasker</string>
    <string name="guide_tasker_steps_title">Add the Snoozer action</string>
    <string name="guide_tasker_step1">In Tasker, open the Tasks tab and tap + to create a task.</string>
    <string name="guide_tasker_step2">Tap + to add an action, then choose Plugin › %1$s.</string>
    <string name="guide_tasker_step3">Tap the pencil next to Configuration, pick Snooze, Unsnooze or Toggle, and tap Save.</string>
    <string name="guide_tasker_step4">Go back to save the action. Run the task, or use it in a profile.</string>
    <string name="guide_tasker_example_title">Example: quiet nights</string>
    <string name="guide_tasker_example_step1">In the Profiles tab, tap + and choose Time. Set it from 22:00 to 07:00.</string>
    <string name="guide_tasker_example_step2">As the entry task, add the action %1$s › Snooze.</string>
    <string name="guide_tasker_example_step3">Long-press the task, choose Add Exit Task and add %1$s › Unsnooze.</string>
    <string name="guide_tasker_other_title">Other automation apps</string>
    <string name="guide_tasker_other_body">Snoozer also works in MacroDroid, Automate and any other app that supports Tasker/Locale plug-ins.</string>

