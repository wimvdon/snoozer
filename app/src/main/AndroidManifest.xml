<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+: needed for the optional persistent "Snoozing notifications" notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional Android 15+ "Snoozer" mode that is switched on while snoozing. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Experimental "Follow Bedtime": read the active modes from the notification service dump (proto format).
         Both can only be granted by the user with adb; without them the feature stays off. -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets the Tasker guide show "Open Tasker" when it is installed (package visibility, API 30+). -->
    <queries>
        <package android:name="net.dinglisch.android.taskerm" />
    </queries>

    <application
        android:name=".SnoozerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Snoozer"
        tools:targetApi="37">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Opened from Settings › Modes › Snoozer: shows Snoozer's settings. -->
            <intent-filter>
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Long-pressing the Quick Settings tile opens the app. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Invisible trampoline used by the launcher shortcut. Not exported: shortcuts
             are started with this app's identity, so no other app can invoke it. -->
        <activity
            android:name=".shortcut.ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Tasker / Locale plug-in: action configuration screen. -->
        <activity
            android:name=".tasker.TaskerEditActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tasker_plugin_label"
            tools:ignore="ExportedActivity">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <!-- Tasker / Locale plug-in: executes the configured action. Must be exported so
             Tasker (and compatible hosts) can deliver the broadcast. -->
        <receiver
            android:name=".tasker.TaskerFireReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <!-- Unsnooze button on the persistent notification. Private: only our PendingIntent. -->
        <receiver
            android:name=".service.UnsnoozeReceiver"
            android:exported="false" />

        <service
            android:name=".service.SnoozeListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.SnoozeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Not an ACTIVE_TILE on purpose: the system then asks for fresh state every time
                 Quick Settings opens, so the tile is always accurate without any service of ours. -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
