<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds have the application ID io.github.impca201.snoozer.debug (see app/build.gradle.kts),
     and a static shortcut must name the exact package. Keep in sync with src/main/res/xml/shortcuts.xml. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_toggle"
        android:shortcutId="toggle_snooze"
        android:shortcutLongLabel="@string/shortcut_toggle_long"
        android:shortcutShortLabel="@string/shortcut_toggle_short">
        <intent
            android:action="io.github.impca201.snoozer.action.TOGGLE"
            android:targetClass="io.github.impca201.snoozer.shortcut.ShortcutActivity"
            android:targetPackage="io.github.impca201.snoozer.debug" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_later"
        android:shortcutId="save_for_later"
        android:shortcutLongLabel="@string/shortcut_later_long"
        android:shortcutShortLabel="@string/shortcut_later_short">
        <intent
            android:action="io.github.impca201.snoozer.action.SAVE_FOR_LATER"
            android:targetClass="io.github.impca201.snoozer.later.LaterPickerActivity"
            android:targetPackage="io.github.impca201.snoozer.debug" />
    </shortcut>
</shortcuts>
